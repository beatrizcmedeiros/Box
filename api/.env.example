# Copie este arquivo para .env (cp .env.example .env)
DATABASE_URL="postgresql://prbox:prbox@localhost:5433/prbox?schema=public"
PORT=3333
WEB_ORIGIN="http://localhost:5173"

# Segredo para assinar os tokens de acesso (mínimo 32 caracteres).
# Gere um valor aleatório: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Contas criadas pelo seed APENAS em desenvolvimento (ignoradas com NODE_ENV=production).
# Academia de demonstração (conta do dono do box), com 4 turmas
SEED_ACADEMIA_EMAIL="academia@prbox.local"
SEED_ACADEMIA_SENHA="academia-dev-2026"

# Professor, membro da academia de demonstração.
SEED_TREINADOR_EMAIL="treinador@prbox.local"
SEED_TREINADOR_SENHA="treinador-dev-2026"

# Aluna de demonstração (vinculada à academia de demonstração), com PRs de exemplo
# (os mesmos valores das telas de modelo do relatório).
SEED_ALUNO_EMAIL="aluna@prbox.local"
SEED_ALUNO_SENHA="aluna-dev-2026"

# Envio de e-mails (códigos de confirmação e de nova senha). Use UMA das opções:
#  1) Resend (https://resend.com): RESEND_API_KEY. Sem domínio verificado no Resend, ele só
#     entrega para o e-mail do dono da conta Resend.
#  2) SMTP, ex.: Gmail com "senha de app" (https://myaccount.google.com/apppasswords):
#     entrega para qualquer e-mail sem domínio próprio (limite do Gmail: ~500 por dia).
# Sem nenhuma, em desenvolvimento o código aparece no terminal da API.
RESEND_API_KEY=""
EMAIL_SMTP_USUARIO=""
EMAIL_SMTP_SENHA=""
# EMAIL_SMTP_HOST="smtp.gmail.com"
# EMAIL_SMTP_PORTA="465"
# Remetente (padrão: o próprio EMAIL_SMTP_USUARIO, ou onboarding@resend.dev no Resend)
# EMAIL_REMETENTE="PR Box <voce@gmail.com>"
